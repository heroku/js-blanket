{
  "name": "@heroku/js-blanket",
  "version": "1.2.0",
  "description": "Framework-agnostic sensitive data scrubbing library for error monitoring and logging",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./core/scrubber": {
      "import": {
        "types": "./dist/esm/core/scrubber.d.ts",
        "default": "./dist/esm/core/scrubber.js"
      },
      "require": {
        "types": "./dist/cjs/core/scrubber.d.ts",
        "default": "./dist/cjs/core/scrubber.js"
      }
    },
    "./core/presets": {
      "import": {
        "types": "./dist/esm/core/presets.d.ts",
        "default": "./dist/esm/core/presets.js"
      },
      "require": {
        "types": "./dist/cjs/core/presets.d.ts",
        "default": "./dist/cjs/core/presets.js"
      }
    },
    "./core/patterns": {
      "import": {
        "types": "./dist/esm/core/patterns.d.ts",
        "default": "./dist/esm/core/patterns.js"
      },
      "require": {
        "types": "./dist/cjs/core/patterns.d.ts",
        "default": "./dist/cjs/core/patterns.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:cjs": "rimraf dist/cjs && tsc -p tsconfig.cjs.json && mkdir -p dist/cjs && echo '{\"type\": \"commonjs\"}' > dist/cjs/package.json",
    "build:esm": "rimraf dist/esm && tsc -p tsconfig.esm.json",
    "build": "pnpm run build:cjs && pnpm run build:esm",
    "test": "mocha --require ./scripts/test-setup.mjs --forbid-only \"dist/esm/**/*.test.js\"",
    "test:watch": "mocha --parallel --watch --reporter dot --require ./scripts/test-setup.mjs \"dist/esm/**/*.test.js\"",
    "test:coverage": "c8 --reporter=text-summary --reporter=lcovonly mocha --require ./scripts/test-setup.mjs --forbid-only \"dist/esm/**/*.test.js\"",
    "prepare": "husky && pnpm run build",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts}\" --fix",
    "prettier": "prettier . --write",
    "format": "pnpm run prettier && pnpm run lint:fix",
    "pretest": "pnpm run build:cjs && pnpm run build:esm && pnpm run type-check",
    "pretest:coverage": "pnpm run build:cjs && pnpm run build:esm && pnpm run type-check",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "check:exports": "pnpm run build && attw --pack --profile node16 && publint",
    "lint-staged": "npx lint-staged",
    "check": "pnpm run format && pnpm run type-check && pnpm test"
  },
  "dependencies": {},
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.10.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "mocha": "^12.0.2",
    "prettier": "^3.8.4",
    "publint": "^0.3.25",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "/dist",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "author": "Heroku",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heroku/js-blanket.git"
  },
  "bugs": {
    "type": "git",
    "url": "https://github.com/heroku/js-blanket/issues"
  },
  "keywords": [
    "pii",
    "scrubbing",
    "security",
    "data-sanitization",
    "error-monitoring",
    "logging"
  ]
}
